# Единые переводы строк: скрипты для Linux должны оставаться с LF
* text=auto eol=lf

*.sh      text eol=lf
*.service text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.ico     binary

*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.vbs     text eol=crlf
